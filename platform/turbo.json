{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": ["MC_RELOJ_DIAS", "MC_RELOJ_ANCLA", "MC_RELOJ_ANCLA_DIAS", "MC_TEST_WORKERS", "MC_PGLITE_FOTO", "MC_PGLITE_FOTO_DIR"],
  "tasks": {
    "build":     { "dependsOn": ["^build"], "outputs": [".next/**", "dist/**"] },
    "dev":       { "cache": false, "persistent": true },
    "typecheck": { "dependsOn": ["^build"] },
    "lint":      {},
    "test":      { "dependsOn": ["^build"], "cache": false },
    "format":    { "cache": false },

    "//#test": {
      "inputs": ["db/migrations/**", "db/seed/**", "db/lib/**", "scripts/verificar.sh", "scripts/pruebas/**", "package.json"],
      "outputs": []
    },

    "@mc/db#test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/db/migrations/**", "$TURBO_ROOT$/db/seed/**"]
    },
    "@mc/connectors#test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/db/migrations/**"]
    },
    "@mc/worker#test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/db/migrations/**"]
    }
  }
}
