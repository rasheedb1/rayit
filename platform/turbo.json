{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build":     { "dependsOn": ["^build"], "outputs": [".next/**", "dist/**"] },
    "dev":       { "cache": false, "persistent": true },
    "typecheck": { "dependsOn": ["^build"] },
    "lint":      {},
    "test":      { "dependsOn": ["^build"] },
    "format":    { "cache": false },

    "//#test": {
      "inputs": ["db/migrations/**", "db/seed/**", "package.json"],
      "outputs": []
    },

    "@mc/db#test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/db/migrations/**", "$TURBO_ROOT$/db/seed/**"]
    },
    "@mc/connectors#test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/db/migrations/**"]
    },
    "@mc/worker#test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/db/migrations/**"]
    }
  }
}
