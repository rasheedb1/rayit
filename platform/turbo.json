{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": ["MC_TEST_WORKERS", "MC_PGLITE_FOTO", "MC_PGLITE_FOTO_DIR"],
  "tasks": {
    "build":     { "dependsOn": ["^build"], "outputs": [".next/**", "dist/**"] },
    "dev":       { "cache": false, "persistent": true },
    "typecheck": { "dependsOn": ["^build"] },
    "lint":      {},
    "test":      { "dependsOn": ["^build"], "cache": false, "env": ["MC_RELOJ_DIAS", "MC_RELOJ_ANCLA", "MC_RELOJ_ANCLA_DIAS"] },
    "format":    { "cache": false },

    "//#test": {
      "inputs": ["db/migrations/**", "db/seed/**", "db/lib/**", "scripts/verificar.sh", "scripts/pruebas/**", "package.json", "packages/db/package.json", "apps/worker/package.json", "packages/db/test/tiempos.ts"],
      "env": ["MC_RELOJ_DIAS", "MC_RELOJ_ANCLA", "MC_RELOJ_ANCLA_DIAS"],
      "outputs": []
    },

    "@mc/db#test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/db/migrations/**", "$TURBO_ROOT$/db/seed/**", "$TURBO_ROOT$/db/lib/**", "$TURBO_ROOT$/scripts/pruebas/**"],
      "env": ["MC_RELOJ_DIAS", "MC_RELOJ_ANCLA", "MC_RELOJ_ANCLA_DIAS"]
    },
    "@mc/connectors#test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/db/migrations/**", "$TURBO_ROOT$/db/lib/**", "$TURBO_ROOT$/scripts/pruebas/**", "$TURBO_ROOT$/packages/db/test/tiempos.ts"],
      "env": ["MC_RELOJ_DIAS", "MC_RELOJ_ANCLA", "MC_RELOJ_ANCLA_DIAS"]
    },
    "@mc/worker#test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/db/migrations/**", "$TURBO_ROOT$/db/seed/**", "$TURBO_ROOT$/db/lib/**", "$TURBO_ROOT$/scripts/pruebas/**", "$TURBO_ROOT$/packages/db/test/**"],
      "env": ["MC_RELOJ_DIAS", "MC_RELOJ_ANCLA", "MC_RELOJ_ANCLA_DIAS"]
    }
  }
}
