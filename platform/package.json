{
  "name": "on-cue-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "migrate:check": "node db/migrate.mjs --pglite",
    "migrate": "node db/migrate.mjs $DATABASE_URL",
    "seed:check": "node db/seed/verify/run.mjs",
    "seed:check:unit": "node --test \"db/seed/verify/*.test.mjs\"",
    "seed:check:futuro": "node db/seed/verify/run.mjs --dias 40",
    "test": "pnpm run seed:check:unit && pnpm run seed:check"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "turbo": "^2.11.2"
  },
  "dependencies": {
    "pg": "^8.13.1"
  }
}
