# Lo que NO sube al build de Vercel. El proyecto tiene Root Directory =
# apps/web, así que se despliega desde platform/ (la raíz del workspace)
# para que pnpm vea el lockfile; esto deja fuera lo que el dashboard no
# necesita y, sobre todo, el vault y las migraciones.
/secrets/
# Solo lo de la raíz: `db/` a secas también excluía packages/db (que la
# web importa) y db/certs, la CA de Supabase que @mc/db necesita en runtime.
/db/migrations/
/db/seed/
/db/scripts/
/db/*.mjs
/scripts/
docs/
docker-compose.yml
Makefile
# apps/worker NO se excluye desde CIM-7: la ruta /api/cron/tick importa
# @mc/worker/tick (el turno del worker corre dentro de la web).
apps/media/
# packages/connectors NO se excluye desde CON-3: la web lo importa (OAuth,
# cifrado y configuración de las apps). Sus fixtures pesan poco y sus
# pruebas caen por **/test/.
# `**/test/**` y no `**/test/`: con la carpeta entera excluida no se puede
# volver a incluir nada de dentro (regla de .gitignore), y la web importa
# @mc/db/test/tiempos desde lib/testing/tiempos.ts (CIM-12), que `next
# build` comprueba aunque no sea una prueba. Sin esa excepción el build de
# Vercel caía con «Cannot find module '@mc/db/test/tiempos'» (9-oct-2026).
**/test/**
!packages/db/test/tiempos.ts
**/*.test.ts
**/*.test.tsx
node_modules/
.next/
# Nada que no sea código (fase 6: se sube platform/ entero con
# `vercel deploy --cwd platform`; ver scripts/vercel.sh).
.env
.env.*
*.env
*.log
*.tsbuildinfo
coverage/
.turbo/
